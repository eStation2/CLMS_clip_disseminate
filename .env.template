# =============================================================================
# CLMS clipping & dissemination - environment configuration template
# =============================================================================
# Copy this file to `.env` and adjust the values for your machine:
#
#     cp .env.template .env
#
# `.env` is gitignored and holds machine-specific values. This template is
# committed to the repository and documents every variable with the default
# (production CDSE) values.
#
# If `.env` is absent, the scripts fall back to these same defaults, so the
# original bare-metal CDSE behaviour is unchanged.
# -----------------------------------------------------------------------------

# Base directory for all runtime data (config lists, logs, outputs).
# Everything below defaults to a path under CLMS_HOME unless overridden.
CLMS_HOME=/home/eouser/clms

# --- Runtime directories -----------------------------------------------------
# Config directory holds the processed-file tracking lists (and netrc files).
CLMS_CONFIG_DIR=/home/eouser/clms/config
# Log directory for the clipper automation log.
CLMS_LOG_DIR=/home/eouser/clms/logs

# --- Processed-file tracking + log file --------------------------------------
CLMS_PROCESSED_INPUT_FILE=/home/eouser/clms/config/processed_input_files.txt
CLMS_PROCESSED_OUTPUT_FILE=/home/eouser/clms/config/processed_output_files.txt
CLMS_LOG_FILE=/home/eouser/clms/logs/clipper_automation.log

# --- Output directories (per ROI) --------------------------------------------
# Clipped AFRI products are written here; SOAM products to the SAM directory.
CLMS_OUTPUT_AFR_DIR=/home/eouser/clms/outputs/afr
CLMS_OUTPUT_SOAM_DIR=/home/eouser/clms/outputs/sam

# --- Input archive root ------------------------------------------------------
# Root of the CDSE EODATA archive. In Docker this is the mount point for the
# read-only /eodata volume. The per-product sub-paths below are joined onto it.
EODATA_ROOT=/eodata

# =============================================================================
# Dissemination (FTP upload to EUMETCAST) - used by dissemination.py and its
# per-region duplicates (dissemination_afr.py / dissemination_soam.py).
# =============================================================================
# The log, config, and per-ROI output directories are reused from the variables
# above (CLMS_LOG_DIR, CLMS_CONFIG_DIR, CLMS_OUTPUT_AFR_DIR, CLMS_OUTPUT_SOAM_DIR).

# FTP endpoint and active-mode networking.
# NOTE: FTP active mode requires CLMS_FTP_LOCAL_IP to be THIS machine's own
# externally reachable IP, and the port range must be open in the firewall.
CLMS_FTP_SERVER=ofids.eumetsat.int
CLMS_FTP_LOCAL_IP=46.60.20.214
CLMS_FTP_PORT_RANGE_START=50000
CLMS_FTP_PORT_RANGE_END=50100

# Per-region remote directory and credentials.
# user_pwd format is "user:password" (passed to pycurl USERPWD).
# These are SECRETS - set real values only in .env (never commit them).
CLMS_AFR_REMOTE_DIR=/out/groups/vito-open-afr-test
CLMS_AFR_USER_PWD=user:pwd

CLMS_SOAM_REMOTE_DIR=/out/groups/vito-open-sam-test
CLMS_SOAM_USER_PWD=user:pwd
